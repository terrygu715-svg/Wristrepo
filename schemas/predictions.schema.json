{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wristbandcode.local/schemas/predictions.schema.json",
  "title": "Night-level predictions, one row per night (T03 contract, v1)",
  "type": "object",
  "required": ["schema_version", "class_order", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "class_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Explicit class order; ambiguous orders are rejected (T03 Done)."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["participant_id", "recording_id", "y_true", "y_pred"],
        "properties": {
          "participant_id": { "type": "string", "minLength": 1 },
          "recording_id": { "type": "string", "minLength": 1 },
          "y_true": { "type": "string", "minLength": 1 },
          "y_pred": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
