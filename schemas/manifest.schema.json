{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wristbandcode.local/schemas/manifest.schema.json",
  "title": "Cohort/acquisition/split manifest (T03 contract, v1)",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["participant_id", "recording_id"],
        "properties": {
          "participant_id": { "type": "string", "minLength": 1 },
          "recording_id": { "type": "string", "minLength": 1 },
          "label": {
            "type": "string",
            "description": "Optional; labels must stay separate from window caches (T15). Row is still valid without it."
          },
          "split": { "enum": ["development", "test", "excluded"] },
          "exclusion_reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
