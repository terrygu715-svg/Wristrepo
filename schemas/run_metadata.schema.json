{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wristbandcode.local/schemas/run_metadata.schema.json",
  "title": "Run metadata and provenance (T03 contract, v1)",
  "type": "object",
  "required": ["schema_version", "run_id", "config_hash", "split_hash", "input_version", "class_order"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "config_hash": { "type": "string", "minLength": 1 },
    "split_hash": { "type": "string", "minLength": 1 },
    "input_version": { "enum": ["full", "reduced"] },
    "class_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
