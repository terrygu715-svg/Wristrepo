{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wristbandcode.local/schemas/config.schema.json",
  "title": "Experiment configuration (T03 contract, v1)",
  "type": "object",
  "required": ["task", "class_order", "input_versions", "source_dir", "output_dir", "run_dir", "unverified_fields"],
  "properties": {
    "task": { "const": "night-level four-class severity classification" },
    "class_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_versions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "enum": ["full", "reduced"] }
    },
    "source_dir": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "run_dir": { "type": "string", "minLength": 1 },
    "unverified_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Pending choices transcribed from docs/decisions.md; must be non-empty until T12/T18/T40 freeze them."
    }
  },
  "additionalProperties": true
}
