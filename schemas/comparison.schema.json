{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wristbandcode.local/schemas/comparison.schema.json",
  "title": "Paired Full vs Reduced bootstrap comparison (T03 contract, v1)",
  "type": "object",
  "required": ["schema_version", "class_order", "full_run_id", "reduced_run_id", "metric_gaps", "n_bootstrap"],
  "properties": {
    "schema_version": { "const": 1 },
    "class_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "full_run_id": { "type": "string", "minLength": 1 },
    "reduced_run_id": { "type": "string", "minLength": 1 },
    "metric_gaps": { "type": "object", "minProperties": 1 },
    "n_bootstrap": {
      "const": 2000,
      "description": "2,000 seeded participant resamples per T25."
    }
  },
  "additionalProperties": true
}
